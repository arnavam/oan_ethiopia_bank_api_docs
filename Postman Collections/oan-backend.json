		{
			"name": "Authentication & IAM",
			"item": [
				{
					"name": "1. Login (Generate JWT)",
					"event": [
						{
							"listen": "test",
							"script": {
								"id": "911a315c-b6f8-48b5-b8c5-793cf33de5a0",
								"exec": [
									"pm.test('Login HTTP 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"const json = pm.response.json();",
									"",
									"",
									"",
									"if (json.message.token) {",
									"    pm.collectionVariables.set('jwt_token', json.message.token);",
									"}"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"id": "d1057b1d-c39d-4029-90d4-223970993daf",
					"protocolProfileBehavior": {
						"disableBodyPruning": true
					},
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"usr\": \"test_agent@coopbank.com\",\n    \"pwd\": \"test_agent@1234\"\n}"
						},
						"url": "{{base_url}}/api/method/oan_a2c.api.auth.login",
						"description": "Authenticates the user using standard Frappe credentials and returns a short-lived JSON Web Token (JWT) intended for frontend stateless session management."
					},
					"response": []
				},
